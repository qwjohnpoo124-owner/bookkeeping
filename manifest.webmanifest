{
  "id": "./",
  "name": "小日子記帳",
  "short_name": "記帳",
  "description": "離線可用的個人記帳 App，可同步到 Google Sheet",
  "lang": "zh-TW",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f6b44",
